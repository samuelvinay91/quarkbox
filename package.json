{
  "name": "quarkbox",
  "version": "1.0.0",
  "private": true,
  "description": "QuarkBox — Secure, elastic cloud sandbox platform for AI agents and developers",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f deploy/docker/docker-compose.yml up -d && npm run dev:api",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "publish:all": "npm publish --workspaces --access public",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^3.0.1"
  },
  "dependencies": {
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "helmet": "^8.3.0"
  },
  "overrides": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/websockets": "12.0.1",
    "@nestjs/platform-socket.io": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/passport": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/typeorm": "12.0.1",
    "@nestjs/config": "12.0.0"
  }
}
