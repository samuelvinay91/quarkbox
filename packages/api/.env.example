# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=quarkbox
DATABASE_PASSWORD=quarkbox_dev
DATABASE_NAME=quarkbox

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-in-production-use-a-real-secret
JWT_EXPIRATION=24h
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Docker
DOCKER_SOCKET=/var/run/docker.sock

# Sandbox Defaults
SANDBOX_DEFAULT_IMAGE=ubuntu:22.04
SANDBOX_DEFAULT_CPU=1
SANDBOX_DEFAULT_MEMORY=512m
SANDBOX_NETWORK=quarkbox-sandboxes
SANDBOX_IDLE_TIMEOUT=1800
